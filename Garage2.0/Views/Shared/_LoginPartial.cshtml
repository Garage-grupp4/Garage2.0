@using Microsoft.AspNetCore.Identity
@using Garage2._0.Models

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
  @if (SignInManager.IsSignedIn(User))
  {
    @* Visar användarnamn utan länk — Manage-sidan är inte scaffoldad i US01 'asp-page="/Account/Manage/Index"
  title="Manage"' bytades 'a' för 'span', *@
    <li class="nav-item">
      <span id="manage" class="nav-link text-dark" asp-area="Identity">Hello
        @UserManager.GetUserName(User)!</span>
      </li>
      <li class="nav-item">
        <form id="logoutForm" class="form-inline" asp-area="Identity" asp-page="/Account/Logout"
              asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
          <button id="logout" type="submit" class="nav-link btn btn-link text-dark border-0">Logout</button>
        </form>
      </li>
    }
else
    {
      <li class="nav-item">
        <a class="nav-link text-dark" id="register" asp-area="Identity" asp-page="/Account/Register">Register</a>
      </li>
      <li class="nav-item">
        <a class="nav-link text-dark" id="login" asp-area="Identity" asp-page="/Account/Login">Login</a>
      </li>
    }
  </ul>

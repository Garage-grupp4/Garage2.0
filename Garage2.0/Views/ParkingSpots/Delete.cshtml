@model Garage2._0.Models.ParkingSpot

@{
    ViewData["Title"] = "Delete Parking Spot";
}

<h1>@ViewData["Title"]</h1>

<h3>Are you sure you want to delete this parking spot?</h3>
<div>
    <h4>Parking Spot</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Number)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Number)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Location)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Location)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.IsOutOfService)
        </dt>
        <dd class="col-sm-10">
            @if (Model?.IsOutOfService == true)
            {
                <span class="badge bg-warning text-dark">Out of Service</span>
            }
            else
            {
                <span class="badge bg-success">Active</span>
            }
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>

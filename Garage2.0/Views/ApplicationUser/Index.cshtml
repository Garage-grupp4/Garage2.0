@using Garage2._0.Constants
@model IEnumerable<ApplicationUserViewModel>
@{
    ViewData["Title"] = "Home Page";
}

<div class="page-header">
    <h1>Users</h1>
    <hr />
</div>

    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Email)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Role)
                </th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Email</td>
                    <td>@item.Role</td>
                    <td class="text-end">
                        <form asp-action="AdminToggle" asp-route-email="@item.Email" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm @(item.Role == Roles.ADMIN ? "btn-danger" : "btn-warning") w-100">
                                @(item.Role == Roles.ADMIN ? "Remove as Admin" : "Set as Admin")
                            </button>
                        </form>
                <!--
                @if (item.Role == Roles.ADMIN)
                {

                    <a asp-action="RemoveAdminRole" asp-route-email="@item.Email" class="btn btn-sm btn-warning">Remove Admin Role</a>
                }
                else
                {
                    <a asp-action="AddAdminRole" asp-route-email="@item.Email" class="btn btn-sm btn-warning">Set to Admin</a>
                }
                -->
                    </td>
                </tr>
            }
        </tbody>
    </table>
@using Garage2._0.Constants
@model Garage2._0.Models.ViewModels.MemberSearchViewModel

@{
    ViewData["Title"] = "Admin Users Page";
}

<div class="page-header">
    <h1>Users</h1>
    <hr />
</div>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="search" value="@Model.Search" class="form-control"
               placeholder="Name, email or person number" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
    <div class="col-auto">
        <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
    </div>
</form>

@if (!Model.Members.Any())
{
    <div class="alert alert-info">No members matched your search.</div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(m => m.Members.First().Email)</th>
                <th>@Html.DisplayNameFor(m => m.Members.First().Role)</th>
                <th>@Html.DisplayNameFor(m => m.Members.First().FirstName)</th>
                <th>@Html.DisplayNameFor(m => m.Members.First().LastName)</th>
                <th>@Html.DisplayNameFor(m => m.Members.First().PersonNumber)</th>
                <th class="text-end">@Html.DisplayNameFor(m => m.Members.First().VehicleCount)</th>
                <th class="text-end">@Html.DisplayNameFor(m => m.Members.First().ActiveParkingsCost)</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Members)
            {
                <tr>
                    <td>@item.Email</td>
                    <td>@item.Role</td>
                    <td>@item.FirstName</td>
                    <td>@item.LastName</td>
                    <td>@item.PersonNumber</td>
                    <td class="text-end">@item.VehicleCount</td>
                    <td class="text-end">@item.ActiveParkingsCost.ToString("N2") kr</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Details</a>

                        <form asp-action="AdminToggle" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="email" value="@item.Email" />
                            <button type="submit" class="btn btn-sm @(item.Role == Roles.ADMIN ? "btn-danger" : "btn-warning")">
                                @(item.Role == Roles.ADMIN ? "Remove as Admin" : "Set as Admin")
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

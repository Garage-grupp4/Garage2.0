@model Garage2._0.Models.ViewModels.EditParkedVehicleViewModel

@{
    ViewData["Title"] = "Edit Vehicle";
}

<div class="page-header">
    <div class="page-header-row">
        <h1>Edit Vehicle</h1>
        <span class="header-reg">@Html.DisplayFor(model => model.OriginalRegistrationNumber)</span>
        <span class="header-meta">
            <strong>Arrival:</strong> @Html.DisplayFor(model => model.ArrivalTime)
        </span>
    </div>
    <hr />
</div>

<div class="form-container">
    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ArrivalTime" />
        <input type="hidden" asp-for="OriginalRegistrationNumber" />

        <div class="mb-3">
            <label asp-for="RegistrationNumber" class="form-label"></label>
            <input asp-for="RegistrationNumber" class="form-control" required />
            <span asp-validation-for="RegistrationNumber" class="text-danger"></span>
        </div>

        @* <div class="mb-3">
            <label asp-for="VehicleType" class="form-label"></label>
            <select asp-for="VehicleType" asp-items="@Html.GetEnumSelectList<VehicleType>()" class="form-select"></select>
            <span asp-validation-for="VehicleType" class="text-danger"></span>
        </div> *@

        <div class="mb-3">
            <label asp-for="VehicleModel" class="form-label"></label>
            <input asp-for="VehicleModel" class="form-control" />
            <span asp-validation-for="VehicleModel" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="VehicleBrand" class="form-label"></label>
            <input asp-for="VehicleBrand" class="form-control" />
            <span asp-validation-for="VehicleBrand" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Color" class="form-label d-block"></label>
            <input type="color" asp-for="Color" class="form-control form-control-color" />
            <span asp-validation-for="Color" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Wheels" class="form-label"></label>
            <input asp-for="Wheels" class="form-control" />
            <span asp-validation-for="Wheels" class="text-danger"></span>
        </div>

        <div class="action-bar">
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-secondary">← Back to List</a>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}

@using System.Security.Claims

@model Garage2._0.Models.ViewModels.CreateParkedVehicleViewModel
@inject IVehicleTypeDropDownService dropdownService
@{
    ViewData["Title"] = "Register New Vehicle";
}

<div class="page-header">
    <h1>Register New Vehicle</h1>
    <hr />
</div>

<div class="form-container">
    <form asp-action="Register">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="RegistrationNumber" class="form-label"></label>
            <input asp-for="RegistrationNumber" class="form-control" required />
            <span asp-validation-for="RegistrationNumber" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="VehicleTypeId" class="form-label">Vehicle</label>
            <select asp-for="VehicleTypeId" class="form-select"
                asp-items="@await dropdownService.GetVehicleTypesAsync()">
                <option value="">-- Select Vehicle --</option>
            </select>
            <span asp-validation-for="VehicleTypeId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="VehicleModel" class="form-label"></label>
            <input asp-for="VehicleModel" class="form-control" required />
            <span asp-validation-for="VehicleModel" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="VehicleBrand" class="form-label"></label>
            <input asp-for="VehicleBrand" class="form-control" required />
            <span asp-validation-for="VehicleBrand" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Color" class="form-label d-block"></label>
            <input type="color" asp-for="Color" class="form-control form-control-color" />
            <span asp-validation-for="Color" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Wheels" class="form-label"></label>
            <input asp-for="Wheels" class="form-control" value="4" min="0" max="64" required />
            <span asp-validation-for="Wheels" class="text-danger"></span>
        </div>

        <div class="action-bar">
            <button type="submit" class="btn btn-primary">Register</button>
            <a asp-action="Index" class="btn btn-secondary">← Back to List</a>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}

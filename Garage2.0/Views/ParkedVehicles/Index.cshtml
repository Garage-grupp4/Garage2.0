@model IEnumerable<Garage2._0.Models.ViewModels.VehicleOverViewModel>
@inject IVehicleTypeDropDownService dropdownService

@{
    ViewData["Title"] = "Garage Overview";
}

<div class="page-header">
    <h1>Parked Vehicles</h1>
    <hr />
</div>


<form asp-action="Index" method="get" class="mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label">Search for license number</label>
            <input type="text" name="license" class="form-control" value="@ViewData["license"]" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Vehicle Type</label>
            <select class="form-select" name="type" 
                 asp-items="@await dropdownService.GetVehicleTypesAsync()">
                <option value="">-- Select Vehicle Type --</option>
            </select>
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-primary">Search</button>
            <a asp-action="Index" class="btn btn-secondary">Reset</a>
        </div>
    </div>
</form>

@if (Model.Count() == 0)
{
    <div class="alert alert-info">No parked vehicles found.</div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>
                    <a asp-action="Index" asp-route-sort="@(ViewData["sort"]?.ToString() == "type" ? "type_d" : "type")"
                       class="text-decoration-none text-dark">
                        @Html.DisplayNameFor(model => model.VehicleType) ⇅
                    </a>
                </th>
                <th>
                    <a asp-action="Index" asp-route-sort="@(ViewData["sort"]?.ToString() == "license" ? "license_d" : "license")"
                       class="text-decoration-none text-dark">
                        @Html.DisplayNameFor(model => model.RegistrationNumber) ⇅
                    </a>
                </th>
                <th>
                    <a asp-action="Index" asp-route-sort="@(ViewData["sort"]?.ToString() == "start" ? "start_d" : "start")"
                       class="text-decoration-none text-dark">
                        @Html.DisplayNameFor(model => model.ArrivalTime) ⇅
                    </a>
                </th>
                <th>
                    <a asp-action="Index" asp-route-sort="@(ViewData["sort"]?.ToString() == "parked" ? "parked_d" : "parked")"
                       class="text-decoration-none text-dark">
                        @Html.DisplayNameFor(model => model.ParkedDuration) ⇅
                    </a>
                </th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.VehicleType</td>
                    <td>@item.RegistrationNumber</td>
                    <td>@item.ArrivalTime</td>
                    <td>@item.ParkedDuration</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Check Out</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@model IEnumerable<Garage2._0.Models.VehicleOverViewModel>

@{
    ViewData["Title"] = "Garage Overview";
}

<h1>Parked Vehicle</h1>

<p>
    <a asp-action="Create">Park Vehicle</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Vehicle Type</th>
            <th>Registration number</th>
            <th>Arrival time</th>
            <th>Time Parked</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach(var item in Model)
        {
         <tr>
             <td>@item.VehicleType</td>
             <td>@item.RegistrationNumber</td>
             <td>@item.ArrivalTime</td>
             <td>@item.ParkedDuration</td>
             <td>
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.Id">Check out</a>
             </td>
         </tr>   
        }
    </tbody>
</table>

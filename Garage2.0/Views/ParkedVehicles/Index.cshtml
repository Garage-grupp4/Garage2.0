@model IEnumerable<Garage2._0.Models.VehicleOverViewModel>

@{
    ViewData["Title"] = "Garage Overview";
}

<h1>Parked Vehicles</h1>

<p>
    <a asp-action="Create">Park Vehicle</a>
</p>

<div class="container">
    <div class="row">
        <form asp-action="Index">
            <div class="col form-group">
                <label class="control-label">License</label>
                <input type="text" name="license" class="form-control" />
            </div>
            <div class="col form-group">
                <input type="submit" value="Search" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<table class="table">
    <thead>
        <tr>
            <th>Vehicle Type</th>
            <th>Registration number</th>
            <th>Arrival time</th>
            <th>Time Parked</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.VehicleType</td>
                <td>@item.RegistrationNumber</td>
                <td>@item.ArrivalTime</td>
                <td>@item.ParkedDuration</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.Id">Leave Parking</a>
                </td>
            </tr>
        }
    </tbody>
</table>

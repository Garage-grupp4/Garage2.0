@model IEnumerable<Garage2._0.Models.VehicleOverViewModel>

@{
    ViewData["Title"] = "Garage Overview";
}

<h1>Parked Vehicles</h1>

<p>
    
    <a asp-action="Create" class="btn btn-primary">+Park Vehicle</a>
</p>

<div class="container">
    <div class="row">
        <form asp-action="Index" method="get">
            <div class="col form-group">
                <label class="control-label">Search for license number</label>
                <input type="text" name="license" class="form-control" value="@ViewData["license"]" />
            </div>
            <div class="col form-group">
                <label class="control-label">Vehicle Type</label>
                <select class="form-select" name="type">
                    <option value=""></option>
                    @foreach (var type in Html.GetEnumSelectList<VehicleType>())
                    {
                        if (ViewData["type"]?.ToString() == type.Text)
                        {
                            <option value="@type.Value" selected>@type.Text</option>
                        }
                        else
                        {
                            <option value="@type.Value">@type.Text</option>
                        }
                    }
                </select>
            </div>
            <div class="col form-group">
                <input type="submit" value="Search" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

@if (Model.Count() == 0)
{
    <span>No parked vehicles found</span>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>
                    <a asp-action="Index" asp-route-sort=@(ViewData["sort"]?.ToString() == "type" ? "type_d" : "type")>@Html.DisplayNameFor(model => model.VehicleType)</a>
                </th>
                <th>
                    <a asp-action="Index" asp-route-sort=@(ViewData["sort"]?.ToString()=="license" ? "license_d" : "license")>@Html.DisplayNameFor(model => model.RegistrationNumber)</a>
                </th>
                <th>
                    <a asp-action="Index" asp-route-sort=@(ViewData["sort"]?.ToString() == "start" ? "start_d" : "start")>@Html.DisplayNameFor(model => model.ArrivalTime)</a>
                </th>
                <th>
                    <a asp-action="Index" asp-route-sort=@(ViewData["sort"]?.ToString() == "parked" ? "parked_d" : "parked")>@Html.DisplayNameFor(model => model.ParkedDuration)</a>
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.VehicleType</td>
                    <td>@item.RegistrationNumber</td>
                    <td>@item.ArrivalTime</td>
                    <td>@item.ParkedDuration</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info">Details</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Checkout</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

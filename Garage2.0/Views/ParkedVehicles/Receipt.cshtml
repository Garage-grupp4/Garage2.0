@model Garage2._0.Models.ReceiptViewModel

@{
    ViewData["Title"] = "Parking Receipt";
}

<div class="page-header">
    <div class="page-header-row">
        <h1>Parking Receipt</h1>
        <span class="header-reg">@Model.RegistrationNumber</span>
        <span class="header-meta">
            <strong>Checked out:</strong> @Model.DepartureTime.ToString("yy-MM-dd HH:mm")
        </span>
    </div>
    <hr />
</div>

<dl class="row">
    <dt class="col-sm-3">Owner</dt>
    <dd class="col-sm-9">@Model.UserFirstName @Model.UserLastName</dd>

    <dt class="col-sm-3">Parking Spot</dt>
    <dd class="col-sm-9">@Model.ParkingSpotNumber</dd>

    <dt class="col-sm-3">Vehicle Type</dt>
    <dd class="col-sm-9">@Model.VehicleType.Name</dd>

    <dt class="col-sm-3">Brand / Model</dt>
    <dd class="col-sm-9">@Model.VehicleBrand @Model.VehicleModel</dd>

    <dt class="col-sm-3">Color</dt>
    <dd class="col-sm-9">
        @if (!string.IsNullOrEmpty(Model.Color))
        {
            <span class="color-swatch" style="background:@Model.Color"></span>
            <span class="ms-2">@Model.Color</span>
        }
        else
        {
            <span class="text-muted">Not specified</span>
        }
    </dd>

    <dt class="col-sm-3">Arrival Time</dt>
    <dd class="col-sm-9">@Model.ArrivalTime.ToString("yy-MM-dd HH:mm")</dd>

    <dt class="col-sm-3">Departure Time</dt>
    <dd class="col-sm-9">@Model.DepartureTime.ToString("yy-MM-dd HH:mm")</dd>

    <dt class="col-sm-3">Total Time Parked</dt>
    <dd class="col-sm-9">@Model.TotalTimeParked.ToString(@"hh\:mm") hours</dd>

    <dt class="col-sm-3">Hourly Rate</dt>
    <dd class="col-sm-9">@Model.HourlyRate.ToString("C") / hour</dd>

    <dt class="col-sm-3">Total Price</dt>
    <dd class="col-sm-9 fw-bold">@Model.TotalPrice.ToString("C")</dd>
</dl>

<div class="action-bar d-print-none">
    <a asp-action="Index" class="btn btn-secondary">← Back to List</a>
    <button onclick="window.print()" class="btn btn-primary">Print Receipt</button>
</div>

@section Scripts {
    <style>
        @@media print {
            nav, header, footer, .action-bar { display: none !important; }
        }
    </style>
}

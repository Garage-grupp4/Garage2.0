@model Garage2._0.Models.ParkedVehicle

@{
    ViewData["Title"] = "Create";
    string? selectedType;
    byte red =128;
    byte blue =128;
    byte green = 128;
}

<h1>Create</h1>

<h4>ParkedVehicle</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="registrationNumber" class="control-label"></label>
                <input asp-for="registrationNumber" class="form-control" required />
                <span asp-validation-for="registrationNumber" class="text-danger"></span>
            </div>
        
            <div class="form-group">
                <label asp-for="vehicleType" class="control-label"></label>
                <select class="form-select" name="type">
                @foreach (var type in Html.GetEnumSelectList<VehicleType>())
                {
                   <option value="@type.Value">@type.Text</option> 
                }
                </select>
                <span asp-validation-for="vehicleType" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="vehicleModel" class="control-label"></label>
                <input asp-for="vehicleModel" class="form-control" required />
                <span asp-validation-for="vehicleModel" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="vehicleBrand" class="control-label" ></label>
                <input asp-for="vehicleBrand" class="form-control" required />
                <span asp-validation-for="vehicleBrand" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="color" class="control-label" ></label>
                <br/>
                <label for="red">red</label>
                <input type="range" min="0" max="255" value="@red" asp-for="color" id="red"/>
                <label>@red</label>
                <br/>
                <label for="green">green</label>
                <input type="range" min="0" max="255" value="@green" asp-for="color" id="green"/>
                <label>@green</label>
                <br/>
                <label for="blue">blue</label>
                <input type="range" min="0" max="255" value="@blue" asp-for="color" id="blue"/>
                <label>@blue</label>
                <span asp-validation-for="color" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="wheels" class="control-label" ></label>
                <input asp-for="wheels" class="form-control" value="4" required />
                <span asp-validation-for="wheels" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

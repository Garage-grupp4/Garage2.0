@model Garage2._0.Models.ViewModels.StatisticsParkedVehicleViewModel

@{
    ViewData["Title"] = "Statistics";
}

<body>
<div>
    <h2>Stats</h2>
    <p>
        Vehicles count: @Html.DisplayFor(model => model.VehicleCount) 
    </p>
    <p>
        total billing for all vehicles in garage: @Html.DisplayFor(model => model.TotalCost) kr 
    </p>
    <p>
        How many wheels for all vehicles: @Html.DisplayFor(model => model.HowManyWheels)
    </p>
</div>
</body>
@model Garage2._0.Models.ViewModels.StatisticsParkedVehicleViewModel

@{
    ViewData["Title"] = "Statistics";
}

<body>
<div>
    <h2>Stats</h2>
    <p>
        @Html.DisplayFor(model => model.VehicleCount) 

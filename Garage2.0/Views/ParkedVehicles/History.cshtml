@model IEnumerable<Garage2._0.Models.ViewModels.ParkingHistoryViewModel>

@{
    ViewData["Title"] = "Parking History";
}

<div class="page-header">
    <h1>My Parking History</h1>
    <hr />
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No parking history yet.</div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Registration Number</th>
                <th>Checked Out</th>
                <th>Total Price</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.RegistrationNumber</td>
                    <td>@item.DepartureTime.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@item.TotalPrice kr</td>
                    <td class="text-end">
                        <a asp-action="Receipt" asp-route-id="@item.ParkingSessionId" class="btn btn-sm btn-outline-secondary">View Receipt</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
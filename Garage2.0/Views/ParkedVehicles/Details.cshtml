@model Garage2._0.Models.ParkedVehicle

@{
    ViewData["Title"] = "Vehicle Details";
}

<div class="page-header">
    <div class="page-header-row">
        <h1>Vehicle Details</h1>
        <span class="header-reg">@Model.RegistrationNumber</span>
        <span class="header-meta">
            <strong>Arrival:</strong> @Html.DisplayFor(model => model.ArrivalTime)
        </span>
    </div>
    <hr />
</div>

<dl class="row">
    <dt class="col-sm-3">Parked Time</dt>
    <dd class="col-sm-9">@((DateTime.Now - Model.ArrivalTime.Value).ToString(@"d\d\ hh\:mm"))</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.VehicleType)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.VehicleType)</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.VehicleModel)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.VehicleModel)</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.VehicleBrand)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.VehicleBrand)</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DepartureTime)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.DepartureTime)</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Color)</dt>
    <dd class="col-sm-9">
        @if (!string.IsNullOrEmpty(Model.Color))
        {
            <span class="color-swatch" style="background:@Model.Color"></span>
        }
        else
        {
            <span class="text-muted">Not specified</span>
        }
    </dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Wheels)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.Wheels)</dd>
</dl>

<div class="action-bar">
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning">Edit</a>
    <a asp-action="Delete" asp-route-id="@Model?.Id" class="btn btn-danger">Check Out</a>
    <a asp-action="Index" class="btn btn-secondary">← Back to List</a>
</div>

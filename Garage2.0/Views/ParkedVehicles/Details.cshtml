@model Garage2._0.Models.ParkedVehicle

@{
    ViewData["Title"] = "Fordonsdetaljer";
}

<h1>Fordonsdetaljer</h1>

<div>
    <h4>Parkerat fordon</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.registrationNumber)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.registrationNumber)
        </dd>
    </dl>
    
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.arrivalTime)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.arrivalTime)
        </dd>
        </dl>
     <dl class="row">
        <dt class = "col-sm-2">
Parkerad tid
        </dt>
        <dd class = "col-sm-10">
@((DateTime.Now - Model.arrivalTime.Value).ToString(@"d\d\ hh\:mm"))
        </dd>
       </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.vehicleType)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.vehicleType)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.vehicleModel)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.vehicleModel)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.vehicleBrand)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.vehicleBrand)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.color)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.color)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.wheels)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.wheels)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Redigera</a> |
    <a asp-action="Delete" asp-route-id="@Model?.Id">Hämta ut</a> |
    <a asp-action="Index">Tillbaka till översikt</a>
</div>

@model Garage2._0.Models.ParkedVehicle

@{
    ViewData["Title"] = "Vehicle Details";
}

<h1>Vehicle Details</h1>

<div>
    <h4>Parked Vehicle</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.registrationNumber)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.registrationNumber)
        </dd>
    </dl>
    
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.arrivalTime)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.arrivalTime)
        </dd>
        </dl>
     <dl class="row">
        <dt class = "col-sm-2">
Parked Time
        </dt>
        <dd class = "col-sm-10">
@((DateTime.Now - Model.arrivalTime.Value).ToString(@"d\d\ hh\:mm"))
        </dd>
       </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.vehicleType)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.vehicleType)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.vehicleModel)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.vehicleModel)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.vehicleBrand)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.vehicleBrand)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.color)
        </dt>
<dd class="col-sm-10">
    @if (!string.IsNullOrEmpty(Model.color))
    {
        <span style="display:inline-block; width:20px; height:20px; background:@Model.color; border:1px solid #ccc; vertical-align:middle;"></span>
    }
</dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.wheels)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.wheels)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Delete" asp-route-id="@Model?.Id">Check Out</a> |
    <a asp-action="Index">Back to List</a>
</div>

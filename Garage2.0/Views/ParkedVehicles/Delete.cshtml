@model Garage2._0.Models.ParkedVehicle

@{
    ViewData["Title"] = "Check Out Vehicle";
}

<h1>Check Out Vehicle</h1>

<h3>Are you sure you want to check out this vehicle?</h3>

<div>
    <dl class="row">
        <dt class="col-sm-2">Registration Number</dt>
        <dd class="col-sm-10">@Model.RegistrationNumber</dd>

        <dt class="col-sm-2">Vehicle Type</dt>
        <dd class="col-sm-10">@Model.VehicleType</dd>

        <dt class="col-sm-2">Arrival Time</dt>
        <dd class="col-sm-10">@Model.ArrivalTime</dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Check Out" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>

@page
@model ForgotPasswordConfirmation
@inject IWebHostEnvironment Env
@{
    ViewData["Title"] = "Forgot password confirmation";
}

<h1>@ViewData["Title"]</h1>
<p>
    If the email address exists in our system, we have sent a link to reset your password.
    Please check your inbox (and spam folder).
</p>

@if (Env.IsDevelopment() && TempData["ResetLink"] != null)
{
    <div class="alert alert-info mt-3">
        <strong>🔧 Dev mode:</strong> No email is sent in development.
        <br />
        <a href="@TempData["ResetLink"]">Click here to reset your password</a>
    </div>
}
